<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WormsLandEditor</RootNamespace>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the real form and renderer, not copies or a headless layout substitute. -->
    <Compile Include="../../src/WormsLandEditor/**/*.cs"
             Exclude="../../src/WormsLandEditor/Program.cs;../../src/WormsLandEditor/obj/**/*.cs;../../src/WormsLandEditor/bin/**/*.cs"
             Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/WormsLandEditor/Resources/*.resx" Link="Resources/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
